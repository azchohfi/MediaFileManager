<UserControl x:Class="MediaFileManager.Desktop.Views.VideoFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <TabView Grid.Column="0"
                     IsAddTabButtonVisible="False">
                <TabViewItem Header="Status"
                             IsClosable="False">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="StatusListBox">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding MessageColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <StackPanel Grid.Row="1"
                                    Spacing="4"
                                    Margin="0,4,0,0">
                            <Button Content="Open TV Show Folder"
                                    HorizontalAlignment="Stretch"
                                    Click="SelectFolderButton_Click"/>
                            <Button Content="Reset"
                                    HorizontalAlignment="Stretch"
                                    Click="ResetButton_Click"/>
                        </StackPanel>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Help"
                             IsClosable="False">
                    <ScrollViewer>
                        <TextBlock TextWrapping="Wrap"
                                   Margin="8">
                            <Run Text="Getting Started"
                                 FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="1. Open a folder to fill the Seasons list."/>
                            <LineBreak/>
                            <Run Text="2. Select season(s) to fill the Episodes list."/>
                            <LineBreak/>
                            <Run Text="3. Select episode(s) to be edited."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Renaming"
                                 FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="1. In the episode name box, highlight the section of the file name to replace."/>
                            <LineBreak/>
                            <Run Text="2. Enter replacement text in the replacement text box."/>
                            <LineBreak/>
                            <Run Text="3. Click Rename to update all selected episode file names."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Renumbering"
                                 FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="1. Select episodes in the EXACT order you want them numbered."/>
                            <LineBreak/>
                            <Run Text="2. Highlight the area that will be replaced with the SxxExx text."/>
                            <LineBreak/>
                            <Run Text="3. Click Rename and Number Episodes to renumber."/>
                        </TextBlock>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>

            <!-- Right area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="175"/>
                </Grid.RowDefinitions>

                <!-- Top: Seasons + Episodes/Preview -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Seasons"
                                   FontWeight="SemiBold"
                                   Margin="8,4"/>
                        <ListBox x:Name="SeasonsListBox"
                                 Grid.Row="1"
                                 SelectionMode="Multiple"
                                 SelectionChanged="SeasonsListBox_SelectionChanged"/>
                    </Grid>

                    <TabView x:Name="EpisodesTabView"
                             Grid.Column="1"
                             IsAddTabButtonVisible="False">
                        <TabViewItem x:Name="EpisodesTabItem"
                                     Header="Episodes"
                                     IsClosable="False">
                            <ListBox x:Name="EpisodesListBox"
                                     SelectionMode="Multiple"
                                     SelectionChanged="EpisodesListBox_SelectionChanged"/>
                        </TabViewItem>
                        <TabViewItem x:Name="PreviewTabItem"
                                     Header="Preview"
                                     IsClosable="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="EpisodeRenamedPreviewListBox"
                                         Grid.ColumnSpan="2"/>

                                <Button x:Name="ApproveResultButton"
                                        Content="Approve"
                                        Background="Green"
                                        Foreground="White"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Margin="4"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Click="ApproveResultButton_Click"/>

                                <Button x:Name="CancelResultButton"
                                        Content="Cancel"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Margin="4"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Click="CancelResultButton_Click"/>
                            </Grid>
                        </TabViewItem>
                    </TabView>
                </Grid>

                <!-- Bottom: Operations TabView -->
                <TabView Grid.Row="1"
                         IsAddTabButtonVisible="False">
                    <TabViewItem Header="Renaming Operations"
                                 IsClosable="False">
                        <StackPanel Margin="5"
                                    Spacing="4">
                            <TextBox x:Name="EpisodeName_Renaming_TextBox"
                                     IsReadOnly="True"
                                     PlaceholderText="Select an episode, then highlight the section of text to be replaced (applied to all selected episodes)."
                                     SelectionChanged="EpisodeNameTextBox_SelectionChanged"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OriginalTextBox_Renaming"
                                         IsReadOnly="True"
                                         PlaceholderText="original text"
                                         TextChanged="OriginalTextBox_Renaming_TextChanged"
                                         Margin="2"/>
                                <TextBox x:Name="ReplacementTextBox"
                                         PlaceholderText="enter replacement text"
                                         Grid.Column="1"
                                         Margin="2"/>
                                <Button x:Name="UpdateFileNameButton"
                                        Content="Rename"
                                        IsEnabled="False"
                                        Click="UpdateFileNameButton_Click"
                                        Grid.Column="2"
                                        Margin="2"/>
                            </Grid>
                        </StackPanel>
                    </TabViewItem>

                    <TabViewItem Header="Renumbering Operations"
                                 IsClosable="False">
                        <StackPanel Margin="5"
                                    Spacing="4">
                            <TextBlock Text="Select the text that will be replaced with: 'show name - SXXEXX -'"/>
                            <TextBox x:Name="EpisodeName_Renumbering_TextBox"
                                     IsReadOnly="True"
                                     PlaceholderText="Select episodes in order, then highlight the text where the season/episode number will be inserted."
                                     SelectionChanged="EpisodeNameTextBox_Renumbering_SelectionChanged"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OriginalTextBox_Renumbering"
                                         IsReadOnly="True"
                                         PlaceholderText="original text"
                                         TextChanged="OriginalTextBox_Renumbering_TextChanged"
                                         Margin="2"/>
                                <TextBox x:Name="SeasonNumberTextBox"
                                         PlaceholderText="season # (e.g. 01)"
                                         TextChanged="SeasonNumberTextBox_TextChanged"
                                         Width="130"
                                         Grid.Column="1"
                                         Margin="2"/>
                                <TextBox x:Name="EpisodeStartTextBox"
                                         PlaceholderText="start ep (e.g. 01)"
                                         Width="130"
                                         Grid.Column="2"
                                         Margin="2"/>
                                <TextBox x:Name="EpisodeEndTextBox"
                                         PlaceholderText="end ep (e.g. 09)"
                                         Width="130"
                                         Grid.Column="3"
                                         Margin="2"/>
                                <Button x:Name="RenumberingButton"
                                        Content="Rename and Number Episodes"
                                        IsEnabled="False"
                                        Click="RenumberingButton_Click"
                                        Grid.Column="4"
                                        Margin="2"/>
                            </Grid>
                        </StackPanel>
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>

        <!-- Busy overlay -->
        <Border x:Name="BusyOverlay"
                Background="#CC000000"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="BusyRing"
                              IsActive="False"
                              Width="48"
                              Height="48"
                              Foreground="White"/>
                <ProgressBar x:Name="BusyProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Width="240"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="BusyTextBlock"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
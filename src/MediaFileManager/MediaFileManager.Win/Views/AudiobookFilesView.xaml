<UserControl x:Class="MediaFileManager.Desktop.Views.AudiobookFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerikGrid="using:Telerik.UI.Xaml.Controls.Grid"
             mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="StatusListBox"
                         Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding MessageColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="1"
                            Spacing="4"
                            Margin="4">
                    <Button Content="Open Author Folder"
                            HorizontalAlignment="Stretch"
                            Click="SelectAuthorFolderButton_Click"/>
                    <Button Content="Reset"
                            HorizontalAlignment="Stretch"
                            Click="ResetButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Right area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- Top: Titles + Files grid -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Audiobook Folders"
                                   FontWeight="SemiBold"
                                   Margin="8,4"/>
                        <ListBox x:Name="AudiobookTitlesListBox"
                                 Grid.Row="1"
                                 SelectionMode="Multiple"
                                 SelectionChanged="AudiobookTitlesListBox_SelectionChanged"/>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Audiobook Files"
                                   FontWeight="SemiBold"
                                   Margin="8,4"/>
                        <telerikGrid:RadDataGrid x:Name="AudiobookFilesGridView"
                                                 Grid.Row="1"
                                                 AutoGenerateColumns="False"
                                                 SelectionMode="Multiple"
                                                 SelectionChanged="AudiobookFilesGridView_SelectionChanged">
                            <telerikGrid:RadDataGrid.Columns>
                                <telerikGrid:DataGridTextColumn PropertyName="FileName"
                                                                Header="File Name"/>
                                <telerikGrid:DataGridTextColumn PropertyName="Title"
                                                                Header="Title"/>
                                <telerikGrid:DataGridTextColumn PropertyName="Album"
                                                                Header="Album"/>
                                <telerikGrid:DataGridTextColumn PropertyName="Artist"
                                                                Header="Artist"/>
                                <telerikGrid:DataGridTextColumn PropertyName="Performer"
                                                                Header="Performer"/>
                            </telerikGrid:RadDataGrid.Columns>
                        </telerikGrid:RadDataGrid>
                    </Grid>
                </Grid>

                <!-- Bottom: Tag editing panel -->
                <Grid Grid.Row="1"
                      Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="AlbumNameTextBox"
                             PlaceholderText="Album Name (book title)"
                             TextChanged="AlbumNameTextBox_TextChanged"
                             Margin="0,4,8,4"
                             Grid.Row="0"
                             Grid.Column="0"/>

                    <CheckBox x:Name="SetAlbumNameCheckBox"
                              Content="Set Album Name"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Grid.Row="0"
                              Grid.Column="1"/>

                    <TextBox x:Name="ArtistTextBox"
                             PlaceholderText="Artist Name / Performer Name (author)"
                             TextChanged="ArtistTextBox_TextChanged"
                             Margin="0,4,8,4"
                             Grid.Row="1"
                             Grid.Column="0"/>

                    <CheckBox x:Name="SetArtistNameCheckBox"
                              Content="Set Artist Name"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Grid.Row="1"
                              Grid.Column="1"/>

                    <Button x:Name="UpdateTagsButton"
                            Content="Update Tags"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Click="SetTagsButton_Click"
                            Margin="0,4,8,4"
                            Grid.Row="2"
                            Grid.Column="0"/>

                    <CheckBox x:Name="SetTitleCheckBox"
                              Content="Set Title (uses file name)"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Grid.Row="2"
                              Grid.Column="1"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Busy overlay -->
        <Border x:Name="BusyOverlay"
                Background="#CC000000"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="BusyRing"
                              IsActive="False"
                              Width="48"
                              Height="48"
                              Foreground="White"/>
                <ProgressBar x:Name="BusyProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Width="240"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="BusyTextBlock"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
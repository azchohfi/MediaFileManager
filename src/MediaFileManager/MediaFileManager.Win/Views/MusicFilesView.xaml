<UserControl x:Class="MediaFileManager.Desktop.Views.MusicFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar: status + controls -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="StatusListBox"
                         Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding MessageColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="1"
                            Spacing="4"
                            Margin="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourceFolderTextBox"
                                 PlaceholderText="Source folder path"
                                 Margin="0,0,4,0"
                                 IsReadOnly="True"/>
                        <Button Content="Browse"
                                Grid.Column="1"
                                Click="BrowseSourceFolderButton_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DestinationFolderTextBox"
                                 PlaceholderText="Destination folder path"
                                 Margin="0,0,4,0"
                                 IsReadOnly="True"/>
                        <Button Content="Browse"
                                Grid.Column="1"
                                Click="BrowseDestinationFolderButton_Click"/>
                    </Grid>
                    <Button Content="Scan Source Folder"
                            HorizontalAlignment="Stretch"
                            Click="ScanSourceFolderButton_Click"/>
                    <Button x:Name="StartProcessingButton"
                            Content="Start Processing"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Click="StartProcessingButton_Click"/>
                    <Button Content="Reset"
                            HorizontalAlignment="Stretch"
                            Click="ResetButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Right area: scan results summary -->
            <Grid Grid.Column="1"
                  Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Scanned Artists / Albums"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ListBox x:Name="ArtistListBox"
                         Grid.Row="1"/>
            </Grid>
        </Grid>

        <!-- Busy overlay -->
        <Border x:Name="BusyOverlay"
                Background="#CC000000"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="BusyRing"
                              IsActive="False"
                              Width="48"
                              Height="48"
                              Foreground="White"/>
                <ProgressBar x:Name="BusyProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Width="240"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="BusyTextBlock"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>